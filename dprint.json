{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "json": {},
  "toml": {},
  "yaml": {},
  "includes": [
    "**/*.toml",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "**/*.yaml"
  ],
  "excludes": [
    "**/build/**",
    "**/.gradle/**",
    ".claude/worktrees/**",
    ".devcontainer/devcontainer-lock.json",
    ".claude/settings.local.json",
    "mise.lock"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.0@215a8b978ae06a9f45656ecbd11b026689adac2adbba97e026620614d8344230",
    "npm:@dprint/toml@0.8.0@c110376a76e5c946884a77095a49189f5ef3c36f7e8e16b16be92eec805391e9",
    "npm:dprint-plugin-yaml@0.6.0@aee3873f443c9f749521ea171cd38ed381491123aa4530684dd0d6e3deb6727b"
  ]
}
